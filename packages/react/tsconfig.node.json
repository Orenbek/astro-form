{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "include": ["rslib.config.ts", "rstest.config.ts", "rstest.setup.ts", ".storybook/**/*"],
  "exclude": ["**/node_modules", "dist", "storybook-static"]
}
