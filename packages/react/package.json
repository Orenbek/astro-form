{
  "name": "@astro-form/react",
  "version": "0.1.7",
  "repository": {
    "type": "git",
    "url": "",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [],
  "main": "./dist/lib/index.js",
  "module": "./dist/es/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.mjs",
      "require": "./dist/lib/index.js",
      "default": "./dist/es/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rslib",
    "build:watch": "rslib --watch",
    "dev": "rslib --watch",
    "prepare": "rslib",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p stories/tsconfig.json"
  },
  "dependencies": {
    "@astro-form/core": "workspace:*",
    "@formily/validator": "^2.3.1",
    "@types/react": "^19.2.18",
    "change-case-all": "^2.1.0",
    "mobx": "^7.0.0",
    "mobx-react-lite": "^5.0.0"
  },
  "devDependencies": {
    "@rsbuild/core": "~2.1.4",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rslib/core": "^0.23.2",
    "@rstest/adapter-rslib": "^0.10.6",
    "@rstest/core": "^0.10.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.10.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.4.6",
    "storybook-addon-rslib": "^3.3.4",
    "storybook-react-rsbuild": "^3.3.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
