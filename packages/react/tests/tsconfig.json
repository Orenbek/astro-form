{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@astro-form/react": ["../src"],
      "@astro-form/react/*": ["../src/*"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["./**/*", "../src", "../rstest.setup.ts"],
  "exclude": ["**/node_modules", "../dist", "../storybook-static"]
}
