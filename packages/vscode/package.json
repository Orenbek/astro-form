{
  "private": true,
  "name": "@astro-form/vscode",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "",
    "directory": "packages/vscode"
  },
  "activationEvents": [
    "onLanguage:astro-form"
  ],
  "main": "./dist/client.js",
  "files": [
    "dist/",
    "languages/",
    "syntaxes/",
    "assets/"
  ],
  "contributes": {
    "languages": [
      {
        "id": "astro-form",
        "extensions": [
          ".aform"
        ],
        "aliases": [
          "aform"
        ],
        "configuration": "./languages/astro-form-language-configuration.json",
        "icon": {
          "light": "./assets/lang-icon-light.svg",
          "dark": "./assets/lang-icon-dark.svg"
        }
      }
    ],
    "snippets": [
      {
        "scope": "astro-form",
        "path": "./languages/astro-form.code-snippets"
      }
    ],
    "grammars": [
      {
        "language": "astro-form",
        "scopeName": "source.astro",
        "path": "./syntaxes/astro.tmLanguage.json",
        "embeddedLanguages": {
          "text.html": "html",
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.json": "json",
          "source.tsx": "typescriptreact",
          "meta.tag.tsx": "jsx-tags",
          "meta.tag.without-attributes.tsx": "jsx-tags",
          "meta.tag.attributes.tsx": "typescriptreact",
          "meta.embedded.expression.tsx": "typescriptreact"
        },
        "unbalancedBracketScopes": [
          "keyword.operator.relational",
          "storage.type.function.arrow",
          "keyword.operator.bitwise.shift",
          "meta.brace.angle",
          "punctuation.definition.tag",
          "keyword.operator.assignment.compound.bitwise.ts"
        ]
      }
    ],
    "typescriptServerPlugins": [
      {
        "name": "astro-form-ts-plugin-bundle",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "breakpoints": [],
    "menus": {},
    "commands": []
  },
  "scripts": {
    "build": "node scripts/build.mjs -- --minify",
    "watch": "node scripts/build.mjs -- --watch",
    "pack": "npm run build && vsce package --pre-release",
    "release": "npm run build && vsce publish --pre-release"
  },
  "devDependencies": {
    "@types/vscode": "^1.82.0",
    "@volar/language-server": "~2.3.1",
    "@volar/vscode": "~2.3.1",
    "esbuild": "latest",
    "esbuild-plugin-copy": "^2.1.1",
    "vsce": "latest",
    "vscode-languageclient": "^9.0.1"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "dependencies": {
    "@astro-form/core": "workspace:^",
    "@astrojs/compiler": "^2.8.0",
    "prettier": "^3.2.5",
    "prettier-plugin-astro-form": "workspace:^"
  }
}
